# Sentry Configuration (Production)
# Get DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/

# Single Sentry project for all components (Frontend, Backend, Sidecar)
# Errors will be automatically tagged by component for filtering
# Example: SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/7654321

SENTRY_DSN=

# Frontend DSN (Vite only exposes VITE_* prefixed vars to client code)
# Set this to the same value as SENTRY_DSN
VITE_SENTRY_DSN=

# Sentry Auth Token (for source map uploads)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:releases, project:write

SENTRY_AUTH_TOKEN=

# Sentry organization slug (for source map uploads)
SENTRY_ORG=query-pilot

# Sentry project name
SENTRY_PROJECT=query-pilot
