# SSH daemon configuration for testing
Port 22
ListenAddress 0.0.0.0

# Authentication
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes
PermitEmptyPasswords no

# SSH Tunneling - ENABLE IT!
AllowTcpForwarding yes
GatewayPorts no
X11Forwarding no
PermitTunnel yes

# Security
StrictModes yes
MaxAuthTries 6
MaxSessions 10

# Logging
SyslogFacility AUTH
LogLevel INFO

# Subsystems
Subsystem sftp /usr/lib/ssh/sftp-server

