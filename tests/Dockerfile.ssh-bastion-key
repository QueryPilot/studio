FROM alpine:latest

# Install OpenSSH
RUN apk add --no-cache openssh openssh-server

# Create SSH user
RUN adduser -D sshuser

# Generate host keys
RUN ssh-keygen -A

# Copy custom sshd_config
COPY sshd_config_nopassword /etc/ssh/sshd_config

# Create .ssh directory and set up authorized_keys
RUN mkdir -p /home/sshuser/.ssh && \
    chmod 700 /home/sshuser/.ssh && \
    chown sshuser:sshuser /home/sshuser/.ssh

# Copy public key
COPY ssh-keys/test_rsa_key.pub /home/sshuser/.ssh/authorized_keys
RUN chmod 600 /home/sshuser/.ssh/authorized_keys && \
    chown sshuser:sshuser /home/sshuser/.ssh/authorized_keys

EXPOSE 22

# Run SSHD in foreground
CMD ["/usr/sbin/sshd", "-D", "-e"]
