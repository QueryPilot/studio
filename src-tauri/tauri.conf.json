{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDB Studio",
  "version": "0.1.0",
  "identifier": "com.hieuvd.devdb-studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Loading…",
        "width": 420,
        "height": 280,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "url": "splash.html",
        "hiddenTitle": true
      },
      {
        "label": "main",
        "title": "DevDB Studio",
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 1000,
        "minHeight": 800,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "clipboard-capability",
        "window-state-capability"
      ]
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "window-state": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": ["sidecars/manifest.json"]
  }
}
