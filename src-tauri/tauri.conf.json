{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Query Pilot",
  "version": "2026.1.0-beta.2",
  "identifier": "dev.querypilot.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Query Pilot",
        "fullscreen": false,
        "center": true,
        "height": 600,
        "width": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "clipboard-capability",
        "window-state-capability",
        "updater-capability"
      ]
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "querypilot"
        ]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/QueryPilot/studio-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDOTMxMURBNDFFRjZDRDUKUldUVmJPOUIyaEdUek9WTFZTVTZpSTJGQUpQMmQzYitVTmV2b3VwY1NlWG5ZY05PYzNJWTRuNGoK",
      "windows": {
        "installMode": "passive"
      }
    },
    "window-state": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "../target/release/querypilot-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Hieu Vu (S5PPDYUJ5F)",
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "files": {},
      "hardenedRuntime": true
    }
  }
}
