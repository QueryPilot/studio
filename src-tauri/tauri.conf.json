{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Query Pilot",
  "version": "0.4.0",
  "identifier": "dev.querypilot.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Query Pilot",
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "height": 600,
        "width": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "clipboard-capability",
        "window-state-capability"
      ]
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "window-state": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Hieu Vu (S5PPDYUJ5F)",
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "files": {},
      "hardenedRuntime": true
    },
    "externalBin": [
      "sidecars/ai-server",
      "sidecars/session-manager-plugin"
    ]
  }
}
