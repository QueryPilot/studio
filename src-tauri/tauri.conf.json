{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Query Pilot",
  "version": "2026.1.0-beta.18",
  "identifier": "dev.querypilot.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Query Pilot",
        "fullscreen": false,
        "center": true,
        "height": 600,
        "width": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "clipboard-capability",
        "window-state-capability",
        "updater-capability"
      ]
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "querypilot"
        ]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/QueryPilot/studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNkZBMUVFRUMxNjQxQUYKUldTdlFSYnM3cUZ2TTFqOGNGQ0wwUFdPVVExZ1ZPNjNjemE5UEFXdjJOcnAySXQ4TTBSTzBPcTQK",
      "windows": {
        "installMode": "passive"
      }
    },
    "window-state": null
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "externalBin": [
      "../target/release/querypilot"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-common",
          "libssl3"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.comodoca.com",
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Hieu Vu (S5PPDYUJ5F)",
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "files": {},
      "hardenedRuntime": true
    }
  }
}
