{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevDB Studio",
  "version": "0.1.0",
  "identifier": "com.hieuvd.devdb-studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevDB Studio",
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "width": 1280,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 800,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "clipboard-capability"]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
